<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SiteYonetim.UI.Avalonia.ViewModels"
             x:Class="SiteYonetim.UI.Avalonia.Views.AidatView"
             x:DataType="vm:AidatViewModel">
    <TabControl>
        <TabItem Header="Tahakkuk Listesi">
            <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Top" Padding="10,8" Background="White">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Yıl:" VerticalAlignment="Center"/>
                        <NumericUpDown Value="{Binding Yil, Mode=TwoWay}" Minimum="2020" Maximum="2050" Width="100"/>
                        <TextBlock Text="Ay:" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <ComboBox ItemsSource="{Binding AylarList}" SelectedIndex="{Binding AyIndex, Mode=TwoWay}" Width="120"/>
                        <Button Content="Listele" Background="#2E86AB" Foreground="White" Command="{Binding LoadTahakkuklarCommand}"/>
                    </StackPanel>
                </Border>
                <Border DockPanel.Dock="Bottom" Padding="10,8" Background="White">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Toplu Tahakkuk Oluştur" Background="#2E86AB" Foreground="White" Command="{Binding TopluTahakkukCommand}"/>
                        <Button Content="Tahsilat Gir" Background="#27AE60" Foreground="White" Command="{Binding TahsilatGirCommand}"/>
                        <Button Content="Gecikme Taz. Uygula" Background="#F39C12" Foreground="White" Command="{Binding GecikmeTazminatiUygulaTabCommand}"/>
                    </StackPanel>
                </Border>
                <DataGrid ItemsSource="{Binding Tahakkuklar}" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Blok" Binding="{Binding Blok}" Width="80"/>
                        <DataGridTextColumn Header="Daire No" Binding="{Binding DaireNo}" Width="90"/>
                        <DataGridTextColumn Header="Sakin" Binding="{Binding Sakin}" Width="*"/>
                        <DataGridTextColumn Header="Aidat Tipi" Binding="{Binding AidatTipi}" Width="140"/>
                        <DataGridTextColumn Header="Tutar" Binding="{Binding Tutar, StringFormat='₺{0:#,##0.00}'}" Width="110"/>
                        <DataGridTextColumn Header="Ödenen" Binding="{Binding Odenen, StringFormat='₺{0:#,##0.00}'}" Width="110"/>
                        <DataGridTextColumn Header="Gecikme" Binding="{Binding GecikmeTaz, StringFormat='₺{0:#,##0.00}'}" Width="110"/>
                        <DataGridTextColumn Header="Durum" Binding="{Binding Durum}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>

        <TabItem Header="Daire Ekstresi">
            <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Top" Padding="10,8" Background="White">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Daire:" VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding Daireler}" SelectedItem="{Binding SelectedDaire, Mode=TwoWay}" Width="220"/>
                        <TextBlock Text="Baş:" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <DatePicker SelectedDate="{Binding EkstreBas, Mode=TwoWay}"/>
                        <TextBlock Text="Bit:" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <DatePicker SelectedDate="{Binding EkstreBit, Mode=TwoWay}"/>
                        <Button Content="Göster" Background="#2E86AB" Foreground="White" Command="{Binding LoadEkstreCommand}"/>
                    </StackPanel>
                </Border>
                <Border DockPanel.Dock="Bottom" Padding="10,8" Background="White">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="PDF İndir" Background="#E74C3C" Foreground="White" Command="{Binding EkstrePdfCommand}"/>
                        <Button Content="Excel İndir" Background="#27AE60" Foreground="White" Command="{Binding EkstreExcelCommand}"/>
                    </StackPanel>
                </Border>
                <DataGrid ItemsSource="{Binding Ekstre}" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Dönem" Binding="{Binding Donem}" Width="90"/>
                        <DataGridTextColumn Header="Aidat Tipi" Binding="{Binding AidatTipi}" Width="*"/>
                        <DataGridTextColumn Header="Tahakkuk" Binding="{Binding Tahakkuk, StringFormat='₺{0:#,##0.00}'}" Width="120"/>
                        <DataGridTextColumn Header="Ödenen" Binding="{Binding Odenen, StringFormat='₺{0:#,##0.00}'}" Width="120"/>
                        <DataGridTextColumn Header="Kalan" Binding="{Binding Kalan, StringFormat='₺{0:#,##0.00}'}" Width="120"/>
                        <DataGridTextColumn Header="Gecikme Taz." Binding="{Binding GecikmeTaz, StringFormat='₺{0:#,##0.00}'}" Width="130"/>
                        <DataGridTextColumn Header="Ödeme Tarihi" Binding="{Binding OdemeTarihi}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>

        <TabItem Header="Gecikme Tazminatı">
            <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Top" Padding="10,8" Background="White">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Yıl:" VerticalAlignment="Center"/>
                        <NumericUpDown Value="{Binding Yil3, Mode=TwoWay}" Minimum="2020" Maximum="2050" Width="100"/>
                        <TextBlock Text="Ay:" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <ComboBox ItemsSource="{Binding AylarList}" SelectedIndex="{Binding Ay3Index, Mode=TwoWay}" Width="120"/>
                        <Button Content="Listele" Background="#2E86AB" Foreground="White" Command="{Binding LoadGecikmeCommand}"/>
                    </StackPanel>
                </Border>
                <Border DockPanel.Dock="Bottom" Padding="10,8" Background="White">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Tümüne Uygula" Background="#E74C3C" Foreground="White" Command="{Binding GecikmeTumuneUygulaCommand}"/>
                        <Button Content="Seçilenlere Uygula" Background="#F39C12" Foreground="White" Command="{Binding GecikmeSecilenlereUygulaCommand}"/>
                    </StackPanel>
                </Border>
                <DataGrid ItemsSource="{Binding GecikmeList}">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="Seç" Binding="{Binding Secili, Mode=TwoWay}" Width="50"/>
                        <DataGridTextColumn Header="Blok" Binding="{Binding Blok}" Width="80" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Daire" Binding="{Binding Daire}" Width="90" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Tutar" Binding="{Binding Tutar, StringFormat='₺{0:#,##0.00}'}" Width="120" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Ödenen" Binding="{Binding Odenen, StringFormat='₺{0:#,##0.00}'}" Width="120" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Vade" Binding="{Binding Vade}" Width="110" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Gecikme Taz." Binding="{Binding GecikmeTaz, StringFormat='₺{0:#,##0.00}'}" Width="140" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>
    </TabControl>
</UserControl>
