<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SiteYonetim.UI.Avalonia.ViewModels.Dialogs"
        x:Class="SiteYonetim.UI.Avalonia.Views.Dialogs.TahsilatGirDialog"
        x:DataType="vm:TahsilatGirDialogViewModel"
        Title="Tahsilat Girişi" Width="660" Height="580" CanResize="False"
        WindowStartupLocation="CenterOwner" Background="White">
    <DockPanel>
        <Border DockPanel.Dock="Top" Height="50" Background="#1E3A5F" Padding="15,10">
            <TextBlock Text="Tahsilat Girişi" Foreground="White" FontSize="16" FontWeight="Bold"/>
        </Border>
        <Border DockPanel.Dock="Bottom" Padding="15,10">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Grid.Column="0" Text="{Binding Hata}" Foreground="#E74C3C" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="İptal" Width="80" Margin="0,0,8,0" Command="{Binding IptalCommand}"/>
                <Button Grid.Column="2" Content="Kaydet" Width="100" Background="#2E86AB" Foreground="White" FontWeight="Bold" Command="{Binding KaydetCommand}"/>
            </Grid>
        </Border>
        <StackPanel Margin="20" Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="Daire:" FontWeight="Bold" Foreground="#1E3A5F" VerticalAlignment="Center" Width="130"/>
                <ComboBox ItemsSource="{Binding Daireler}" SelectedItem="{Binding SelectedDaire, Mode=TwoWay}" Width="470"/>
            </StackPanel>
            <TextBlock Text="Açık Tahakkuklar:" FontWeight="Bold" Foreground="#1E3A5F" Margin="0,10,0,0"/>
            <DataGrid ItemsSource="{Binding AcikTahakkuklar}" SelectedItem="{Binding SelectedTahakkuk, Mode=TwoWay}" IsReadOnly="True" Height="200">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Dönem" Binding="{Binding Donem}" Width="90"/>
                    <DataGridTextColumn Header="Aidat Tipi" Binding="{Binding AidatTipi}" Width="*"/>
                    <DataGridTextColumn Header="Tutar" Binding="{Binding Tutar, StringFormat='₺{0:#,##0.00}'}" Width="110"/>
                    <DataGridTextColumn Header="Ödenen" Binding="{Binding Odenen, StringFormat='₺{0:#,##0.00}'}" Width="110"/>
                    <DataGridTextColumn Header="Kalan" Binding="{Binding Kalan, StringFormat='₺{0:#,##0.00}'}" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
                <TextBlock Text="Ödeme Tutarı (₺):" FontWeight="Bold" Foreground="#1E3A5F" VerticalAlignment="Center" Width="130"/>
                <NumericUpDown Value="{Binding Tutar, Mode=TwoWay}" Minimum="0" Maximum="1000000" Width="180"/>
                <TextBlock Text="Ödeme Tipi:" FontWeight="Bold" Foreground="#1E3A5F" VerticalAlignment="Center" Margin="20,0,0,0"/>
                <ComboBox ItemsSource="{Binding OdemeTipleri}" SelectedItem="{Binding SelectedOdemeTipi, Mode=TwoWay}" Width="140"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="Açıklama:" FontWeight="Bold" Foreground="#1E3A5F" VerticalAlignment="Center" Width="130"/>
                <TextBox Text="{Binding Aciklama, Mode=TwoWay}" Width="470"/>
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Window>
