<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SiteYonetim.UI.Avalonia.ViewModels.Dialogs"
        x:Class="SiteYonetim.UI.Avalonia.Views.Dialogs.SakinEkleDialog"
        x:DataType="vm:SakinEkleDialogViewModel"
        Title="{Binding Baslik}" Width="520" Height="560" CanResize="False"
        WindowStartupLocation="CenterOwner" Background="White">
    <DockPanel>
        <Border DockPanel.Dock="Top" Height="50" Background="#1E3A5F" Padding="15,10">
            <TextBlock Text="{Binding Baslik}" Foreground="White" FontSize="16" FontWeight="Bold"/>
        </Border>
        <Border DockPanel.Dock="Bottom" Padding="15,10">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Grid.Column="0" Text="{Binding Hata}" Foreground="#E74C3C" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="İptal" Width="80" Margin="0,0,8,0" Command="{Binding IptalCommand}"/>
                <Button Grid.Column="2" Content="Kaydet" Width="100" Background="#2E86AB" Foreground="White" FontWeight="Bold" Command="{Binding KaydetCommand}"/>
            </Grid>
        </Border>
        <Grid Margin="20" ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Ad:" FontWeight="Bold" Foreground="#1E3A5F" VerticalAlignment="Center" Margin="0,5"/>
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Ad, Mode=TwoWay}" Margin="0,5"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Soyad:" FontWeight="Bold" Foreground="#1E3A5F" VerticalAlignment="Center" Margin="0,5"/>
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Soyad, Mode=TwoWay}" Margin="0,5"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="TC Kimlik:" FontWeight="Bold" Foreground="#1E3A5F" VerticalAlignment="Center" Margin="0,5"/>
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding TcKimlik, Mode=TwoWay}" MaxLength="11" Margin="0,5"/>
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Telefon:" FontWeight="Bold" Foreground="#1E3A5F" VerticalAlignment="Center" Margin="0,5"/>
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Telefon, Mode=TwoWay}" Margin="0,5"/>
            <TextBlock Grid.Row="4" Grid.Column="0" Text="Email:" FontWeight="Bold" Foreground="#1E3A5F" VerticalAlignment="Center" Margin="0,5"/>
            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Email, Mode=TwoWay}" Margin="0,5"/>
            <TextBlock Grid.Row="5" Grid.Column="0" Text="Daire:" FontWeight="Bold" Foreground="#1E3A5F" VerticalAlignment="Center" Margin="0,5"/>
            <ComboBox Grid.Row="5" Grid.Column="1" ItemsSource="{Binding Daireler}" SelectedItem="{Binding SelectedDaire, Mode=TwoWay}" HorizontalAlignment="Stretch" Margin="0,5"/>
            <TextBlock Grid.Row="6" Grid.Column="0" Text="Sakin Tipi:" FontWeight="Bold" Foreground="#1E3A5F" VerticalAlignment="Center" Margin="0,5"/>
            <ComboBox Grid.Row="6" Grid.Column="1" ItemsSource="{Binding Tipler}" SelectedItem="{Binding SelectedTip, Mode=TwoWay}" HorizontalAlignment="Stretch" Margin="0,5"/>
            <TextBlock Grid.Row="7" Grid.Column="0" Text="Giriş Tarihi:" FontWeight="Bold" Foreground="#1E3A5F" VerticalAlignment="Center" Margin="0,5"/>
            <DatePicker Grid.Row="7" Grid.Column="1" SelectedDate="{Binding GirisTarihi, Mode=TwoWay}" Margin="0,5"/>
        </Grid>
    </DockPanel>
</Window>
