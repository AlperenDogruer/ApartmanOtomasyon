<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SiteYonetim.UI.Avalonia.ViewModels.Dialogs"
        x:Class="SiteYonetim.UI.Avalonia.Views.Dialogs.GelirGiderDialog"
        x:DataType="vm:GelirGiderDialogViewModel"
        Title="{Binding Baslik}" Width="460" Height="480" CanResize="False"
        WindowStartupLocation="CenterOwner" Background="White">
    <DockPanel>
        <Border DockPanel.Dock="Top" Height="50" Background="#1E3A5F" Padding="15,10">
            <TextBlock Text="{Binding Baslik}" Foreground="White" FontSize="16" FontWeight="Bold"/>
        </Border>
        <Border DockPanel.Dock="Bottom" Padding="15,10">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Grid.Column="0" Text="{Binding Hata}" Foreground="#E74C3C" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="İptal" Width="80" Margin="0,0,8,0" Command="{Binding IptalCommand}"/>
                <Button Grid.Column="2" Content="Kaydet" Width="100" Background="#2E86AB" Foreground="White" FontWeight="Bold" Command="{Binding KaydetCommand}"/>
            </Grid>
        </Border>
        <StackPanel Margin="20" Spacing="8">
            <TextBlock Text="Açıklama:" FontWeight="Bold" Foreground="#1E3A5F"/>
            <TextBox Text="{Binding Aciklama, Mode=TwoWay}"/>
            <TextBlock Text="Tutar:" FontWeight="Bold" Foreground="#1E3A5F"/>
            <NumericUpDown Value="{Binding Tutar, Mode=TwoWay}" Minimum="0" Maximum="99999999"/>
            <TextBlock Text="Tarih:" FontWeight="Bold" Foreground="#1E3A5F"/>
            <DatePicker SelectedDate="{Binding Tarih, Mode=TwoWay}"/>
            <TextBlock Text="Kategori:" FontWeight="Bold" Foreground="#1E3A5F"/>
            <ComboBox ItemsSource="{Binding Kategoriler}" SelectedItem="{Binding Kategori, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
            <TextBlock Text="Ödeme Tipi:" FontWeight="Bold" Foreground="#1E3A5F"/>
            <ComboBox ItemsSource="{Binding OdemeTipleri}" SelectedItem="{Binding OdemeTipi, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
            <TextBlock Text="Belge No:" FontWeight="Bold" Foreground="#1E3A5F"/>
            <TextBox Text="{Binding BelgeNo, Mode=TwoWay}"/>
            <TextBlock Text="Tedarikçi:" FontWeight="Bold" Foreground="#1E3A5F" IsVisible="{Binding TedarikciGoster}"/>
            <TextBox Text="{Binding Tedarikci, Mode=TwoWay}" IsVisible="{Binding TedarikciGoster}"/>
        </StackPanel>
    </DockPanel>
</Window>
